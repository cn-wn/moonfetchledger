----
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
}
----

///|
async fn checked(args : Array[String]) -> Unit {
  let effective = if args.length() == 2 && args[0] == "run" &&
    args[1].has_suffix(".mbtx") {
    ["run", "--deny-warn", args[1]]
  } else {
    args
  }
  println("verify: \{Repr(effective)}")
  @shell.Cmd("moon", effective).run(timeout_ms=180000)
}

///|
async fn main {
  checked(["version", "--all"])
  checked(["tree"])
  let inventory = @shell.Cmd("git", [
    "ls-files", "--cached", "--others", "--exclude-standard",
  ]).output()
  inventory.check()
  let before : Map[String, String] = Map([])
  for path in inventory.stdout().split("\n") {
    let path = path.trim().to_owned()
    if path.has_suffix(".mbt") ||
      path.has_suffix(".mbtx") ||
      path.has_suffix(".mbti") ||
      path.has_suffix(".mbt.md") ||
      path == "moon.mod" ||
      path.has_suffix("moon.pkg") {
      before[path] = @fs.read_file(path).text()
    }
  }
  checked(["fmt"])
  checked([
    "fmt", "--check", "scripts/verify.mbtx", "scripts/recovery_demo.mbtx", "scripts/local_storage_demo.mbtx",
    "scripts/auth_demo.mbtx", "scripts/manifest_demo.mbtx", "scripts/checkpoint_recovery_demo.mbtx",
    "scripts/reference_demo.mbtx", "scripts/reference_recovery_demo.mbtx", "scripts/wsgidav_demo.mbtx",
    "scripts/delta_update_demo.mbtx", "scripts/signed_update_demo.mbtx", "scripts/seed_pool_demo.mbtx",
  ])
  checked(["info"])
  checked(["info", "--target", "native"])
  for path, content in before {
    if @fs.read_file(path).text() != content {
      fail("format/interface drift: \{path}")
    }
  }
  checked(["check", "--target", "all", "--deny-warn"])
  for target in ["wasm", "wasm-gc", "js", "native"] {
    checked(["test", "--target", target, "--deny-warn"])
  }
  checked(["run", "--target", "wasm", "examples/assemble"])
  checked(["run", "--target", "wasm", "examples/release"])
  checked(["run", "--target", "native", "examples/release"])
  checked(["run", "--target", "native", "examples/release-state"])
  checked(["run", "--target", "native", "examples/assemble"])
  checked(["run", "scripts/recovery_demo.mbtx"])
  checked(["run", "scripts/local_storage_demo.mbtx"])
  checked(["run", "--target", "native", "examples/controlled"])
  checked(["run", "--target", "native", "examples/webdav"])
  checked(["run", "--target", "native", "examples/reference"])
  checked(["run", "--target", "native", "examples/delta"])
  checked(["run", "scripts/auth_demo.mbtx"])
  checked(["run", "scripts/manifest_demo.mbtx"])
  checked(["run", "scripts/checkpoint_recovery_demo.mbtx"])
  checked(["run", "scripts/reference_demo.mbtx"])
  checked(["run", "scripts/reference_recovery_demo.mbtx"])
  checked(["run", "scripts/delta_update_demo.mbtx"])
  checked(["run", "scripts/signed_update_demo.mbtx"])
  checked(["run", "scripts/seed_pool_demo.mbtx"])
  println(
    "verified formatting, interfaces, four core targets, real-data assembly and HTTP/disk recovery",
  )
}
