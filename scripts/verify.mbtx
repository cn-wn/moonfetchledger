import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
}

async fn main {
  let inventory = @shell.Cmd("git", ["ls-files", "--cached", "--others", "--exclude-standard"]).output()
  inventory.check()
  let before : Map[String, String] = Map([])
  for path in inventory.stdout().split("\n") {
    let path = path.trim().to_owned()
    if path.has_suffix(".mbt") || path.has_suffix(".mbti") || path.has_suffix(".mbt.md") ||
      path == "moon.mod" || path.has_suffix("moon.pkg") {
      before[path] = @fs.read_file(path).text()
    }
  }
  @shell.Cmd("moon", ["fmt"]).run()
  @shell.Cmd("moon", ["info"]).run()
  for path, content in before {
    if @fs.read_file(path).text() != content { fail("format/interface drift: \{path}") }
  }
  @shell.Cmd("moon", ["check", "--target", "all", "--deny-warn"]).run()
  for target in ["wasm", "wasm-gc", "js", "native"] {
    @shell.Cmd("moon", ["test", "--target", target, "--deny-warn"]).run()
  }
  @shell.Cmd("moon", ["run", "--target", "wasm", "examples/assemble"]).run()
  @shell.Cmd("moon", ["run", "--target", "native", "examples/assemble"]).run()
  println("verified formatting, interfaces, four core targets and real-data assembly")
}
