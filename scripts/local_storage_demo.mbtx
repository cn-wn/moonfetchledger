----
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}
----

///|
fn repair_progress_lines(stdout : String) -> Array[String] raise {
  let events = []
  for raw in stdout.split("\n") {
    // Normalize only the CR in a platform CRLF delimiter, not JSON content.
    let line = raw.strip_suffix("\r").unwrap_or(raw)
    if line.has_prefix("[") {
      assert_eq(@json.parse(line).stringify(), line.to_owned())
      events.push(line.to_owned())
    }
  }
  events
}

///|
async fn invoke(path : String, extra : Array[String]) -> @shell.Output {
  let args = [
    "run", "--target", "native", "cmd/fetch", "--", "--url", "http://127.0.0.1:1/local",
    "--output", path, "--length", "28008", "--etag", "\"fixture-v1\"", "--sha256",
    "dca55780e807e6b6dc5dafe53a621bf99929681551ab85bb4a27f5142e208042",
  ]
  if !extra.contains("--audit") &&
    !extra.contains("--export-to") &&
    !extra.contains("--repair-from") {
    args.append(["--chunk-size", "4096"])
  }
  args.append(extra)
  @shell.Cmd("moon", args).output(timeout_ms=120000)
}

///|
async fn main {
  let sample = "[\"MFLREPAIR1\",\"paused\",\"7\",\"3\",\"1\",null]"
  assert_eq(repair_progress_lines(sample + "\nsummary\n"), [sample])
  assert_eq(repair_progress_lines(sample + "\r\nsummary\r\n"), [sample])
  if @env.args().contains("--check-progress-lines") {
    println("repair progress LF/CRLF decoding verified")
    return
  }
  let data = @fs.read_file("fixtures/earthquakes-2024-01-01.csv").binary()
  let dir = @fs.tmpdir(prefix="moonfetchledger-local-")
  defer @fs.rmdir(dir, recursive=true)
  let path = dir + "/retained.csv"
  @fs.write_file(path, data)
  let adopted = invoke(path, ["--adopt"])
  adopted.check()
  assert_true(adopted.stdout().contains("adopted: confirmed=28008"))
  assert_eq(@fs.read_file(path).binary(), data)
  let checkpoint = @fs.read_file(path + ".mfl").binary()
  // All session readers refuse the same malformed bytes, preserving actual data.
  let input_backup = dir + "/input-backup.csv"
  @fs.write_file(input_backup, data)
  @fs.write_file(path + ".mfl", b"\xff")
  for
    extra in [
      ["--audit"],
      [],
      ["--repair-from", input_backup],
      ["--export-to", dir + "/input-refused.csv"],
    ] {
    let rejected = invoke(path, extra)
    assert_true(rejected.exit_code() != 0)
    assert_true(
      (rejected.stdout() + rejected.stderr()).contains("strict UTF-8"),
    )
    assert_eq(@fs.read_file(path + ".mfl").binary(), b"\xff")
    assert_eq(@fs.read_file(path).binary(), data)
    assert_true(
      !@fs.exists(path + ".mfl.next") && !@fs.exists(dir + "/input-refused.csv"),
    )
  }
  @fs.write_file(path + ".mfl", checkpoint)
  let audit = invoke(path, ["--audit"])
  audit.check()
  let invalid_progress = invoke(path, ["--audit", "--progress"])
  assert_true(invalid_progress.exit_code() != 0)
  assert_eq(@fs.read_file(path + ".mfl").binary(), checkpoint)
  assert_eq(
    @json.parse(audit.stdout().trim()).stringify(),
    "[\"MFLAUDIT1\",true,true,\"28008\",\"28008\",[],[]]",
  )
  let reused = invoke(path, [])
  reused.check()
  assert_true(reused.stdout().contains("fetched=0 retained=28008"))
  assert_eq(@fs.read_file(path + ".mfl").binary(), checkpoint)
  let ready = dir + "/ready.csv"
  let exported = invoke(path, ["--export-to", ready])
  exported.check()
  assert_true(exported.stdout().contains("exported: bytes=28008"))
  assert_eq(@fs.read_file(ready).binary(), data)
  assert_eq(@fs.read_file(path).binary(), data)
  assert_eq(@fs.read_file(path + ".mfl").binary(), checkpoint)
  assert_true(!@fs.exists(ready + ".next"))
  let repeated_export = invoke(path, ["--export-to", ready])
  assert_true(repeated_export.exit_code() != 0)
  assert_eq(@fs.read_file(ready).binary(), data)
  let conflict = invoke(path, ["--export-to", dir + "/conflict", "--audit"])
  assert_true(conflict.exit_code() != 0)
  assert_true(!@fs.exists(dir + "/conflict"))
  let repeated = invoke(path, ["--adopt"])
  assert_true(repeated.exit_code() != 0)
  assert_eq(@fs.read_file(path).binary(), data)
  assert_eq(@fs.read_file(path + ".mfl").binary(), checkpoint)
  let file = @fs.open(path, mode=ReadWrite)
  file.write_at(b"\x00", position=3L)
  file.sync()
  file.close()
  let damaged = invoke(path, ["--audit"])
  damaged.check()
  assert_eq(
    @json.parse(damaged.stdout().trim()).stringify(),
    "[\"MFLAUDIT1\",false,true,\"28008\",\"23912\",[[\"0\",\"4096\"]],[[\"0\",\"4096\"]]]",
  )
  assert_eq(@fs.read_file(path + ".mfl").binary(), checkpoint)
  let refused_path = dir + "/refused.csv"
  let refused = invoke(path, ["--export-to", refused_path])
  assert_true(refused.exit_code() != 0)
  assert_true(
    (refused.stdout() + refused.stderr()).contains("recorded block [0,4096)"),
  )
  assert_true(!@fs.exists(refused_path) && !@fs.exists(refused_path + ".next"))
  assert_eq(@fs.read_file(path + ".mfl").binary(), checkpoint)
  let backup = dir + "/backup.csv"
  @fs.write_file(backup, data)
  let repaired = invoke(path, ["--repair-from", backup])
  repaired.check()
  assert_true(
    repaired.stdout().contains("copied=1 retained=23912 invalidated=1"),
  )
  assert_eq(@fs.read_file(path).binary(), data)
  assert_eq(@fs.read_file(backup).binary(), data)
  let repeated_repair = invoke(path, ["--repair-from", backup])
  repeated_repair.check()
  assert_true(repeated_repair.stdout().contains("copied=0 retained=28008"))
  let checkpoint = @fs.read_file(path + ".mfl").binary()
  let recovered_export = invoke(path, ["--export-to", refused_path])
  recovered_export.check()
  assert_eq(@fs.read_file(refused_path).binary(), data)
  assert_eq(@fs.read_file(path + ".mfl").binary(), checkpoint)
  let file = @fs.open(path, mode=ReadWrite)
  file.write_at(b"\x00", position=8195L)
  file.write_at(b"\x00", position=20483L)
  file.sync()
  file.close()
  let damaged = @fs.read_file(path).binary()
  let saved = @fs.read_file(path + ".mfl").binary()
  for
    unsupported in [
      ["--parallel", "2"],
      ["--chunk-size", "4096"],
      ["--stop-after-blocks", "-1"],
    ] {
    let args = ["--repair-from", backup, "--progress"]
    args.append(unsupported)
    assert_true(invoke(path, args).exit_code() != 0)
    assert_eq(@fs.read_file(path).binary(), damaged)
    assert_eq(@fs.read_file(path + ".mfl").binary(), saved)
  }
  let paused = invoke(path, [
    "--repair-from", backup, "--stop-after-blocks", "1", "--progress",
  ])
  paused.check()
  assert_true(
    paused
    .stdout()
    .contains(
      "repair-paused: confirmed=23912 copied=1 retained=19816 invalidated=2",
    ),
  )
  let events = repair_progress_lines(paused.stdout())
  assert_eq(events, [
    "[\"MFLREPAIR1\",\"recovered\",\"28008\",\"19816\",\"0\",null]", "[\"MFLREPAIR1\",\"block\",\"28008\",\"23912\",\"1\",[\"8192\",\"12288\"]]",
    "[\"MFLREPAIR1\",\"paused\",\"28008\",\"23912\",\"1\",null]",
  ])
  let audit = invoke(path, ["--audit"])
  audit.check()
  assert_eq(
    @json.parse(audit.stdout().trim()).stringify(),
    "[\"MFLAUDIT1\",false,true,\"28008\",\"23912\",[[\"20480\",\"24576\"]],[]]",
  )
  let resumed = invoke(path, ["--repair-from", backup, "--progress"])
  resumed.check()
  assert_true(
    resumed
    .stdout()
    .contains("repaired: confirmed=28008 copied=1 retained=23912 invalidated=0"),
  )
  assert_true(
    resumed
    .stdout()
    .contains("[\"MFLREPAIR1\",\"complete\",\"28008\",\"28008\",\"1\",null]"),
  )
  assert_eq(@fs.read_file(path).binary(), data)
  assert_eq(@fs.read_file(backup).binary(), data)
  assert_eq(@fs.read_file(path + ".mfl").binary(), checkpoint)
  let complete = invoke(path, [
    "--repair-from", backup, "--stop-after-blocks", "0", "--progress",
  ])
  complete.check()
  assert_true(
    complete
    .stdout()
    .contains("repaired: confirmed=28008 copied=0 retained=28008"),
  )
  println(
    "local storage workflow verified: strict checkpoint refusal/recovery, adoption, audit/reuse, export, offline selective repair, saved JSON progress, one-block pause/resume retaining 23912 bytes and complete zero-budget reopen",
  )
}
