///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/json",
}

///|
async fn invoke(path : String, extra : Array[String]) -> @shell.Output {
  let args = [
    "run", "--target", "native", "cmd/fetch", "--", "--url", "http://127.0.0.1:1/local",
    "--output", path, "--length", "28008", "--etag", "\"fixture-v1\"", "--sha256",
    "dca55780e807e6b6dc5dafe53a621bf99929681551ab85bb4a27f5142e208042",
  ]
  if !extra.contains("--audit") {
    args.append(["--chunk-size", "4096"])
  }
  args.append(extra)
  @shell.Cmd("moon", args).output(timeout_ms=120000)
}

///|
async fn main {
  let data = @fs.read_file("fixtures/earthquakes-2024-01-01.csv").binary()
  let dir = @fs.tmpdir(prefix="moonfetchledger-local-")
  defer @fs.rmdir(dir, recursive=true)
  let path = dir + "/retained.csv"
  @fs.write_file(path, data)
  let adopted = invoke(path, ["--adopt"])
  adopted.check()
  assert_true(adopted.stdout().contains("adopted: confirmed=28008"))
  assert_eq(@fs.read_file(path).binary(), data)
  let checkpoint = @fs.read_file(path + ".mfl").binary()
  let audit = invoke(path, ["--audit"])
  audit.check()
  assert_eq(
    @json.parse(audit.stdout().trim()).stringify(),
    "[\"MFLAUDIT1\",true,true,\"28008\",\"28008\",[],[]]",
  )
  let reused = invoke(path, [])
  reused.check()
  assert_true(reused.stdout().contains("fetched=0 retained=28008"))
  assert_eq(@fs.read_file(path + ".mfl").binary(), checkpoint)
  let repeated = invoke(path, ["--adopt"])
  assert_true(repeated.exit_code() != 0)
  assert_eq(@fs.read_file(path).binary(), data)
  assert_eq(@fs.read_file(path + ".mfl").binary(), checkpoint)
  let file = @fs.open(path, mode=ReadWrite)
  file.write_at(b"\x00", position=3L)
  file.sync()
  file.close()
  let damaged = invoke(path, ["--audit"])
  damaged.check()
  assert_eq(
    @json.parse(damaged.stdout().trim()).stringify(),
    "[\"MFLAUDIT1\",false,true,\"28008\",\"23912\",[[\"0\",\"4096\"]],[[\"0\",\"4096\"]]]",
  )
  assert_eq(@fs.read_file(path + ".mfl").binary(), checkpoint)
  println(
    "local adoption verified: original bytes retained, complete offline audit, zero-request reuse, existing-session refusal and later corruption detection",
  )
}
