----
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/http",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/async@0.22.4/socket",
  "moonbitlang/core/json",
  "moonbitlang/core/string" @strconv,
}
----

///|
async fn invoke(
  url : String,
  path : String,
  extra : Array[String],
) -> @shell.Output {
  let args = [
    "run", "--target", "native", "cmd/fetch", "--", "--url", url, "--output", path,
    "--length", "28008", "--etag", "\"fixture-v1\"", "--sha256", "dca55780e807e6b6dc5dafe53a621bf99929681551ab85bb4a27f5142e208042",
  ]
  if !extra.contains("--audit") {
    args.append(["--chunk-size", "4096"])
  }
  args.append(extra)
  @shell.Cmd("moon", args).output(timeout_ms=120000)
}

///|
async fn main {
  let data = @fs.read_file("fixtures/earthquakes-2024-01-01.csv").binary()
  assert_eq(data.length(), 28008)
  let dir = @fs.tmpdir(prefix="moonfetchledger-e2e-")
  defer @fs.rmdir(dir, recursive=true)
  let requested : Array[Int32] = []
  let completed : Array[Int32] = []
  let mut reject_once = true
  let mut reverse_first = true
  let mut transient = 0
  let mut exhaust = true
  let mut timeout_once = true
  @async.with_task_group(group => {
    let server = @http.Server::Server(@socket.Addr::parse("127.0.0.1:0"))
    defer server.close()
    let url = "http://127.0.0.1:\{server.addr.port()}"
    let serving = group.spawn(() => {
      while true {
        let (conn, _) = server.accept()
        let request = conn.read_request()
        if request.path == "/__stop" {
          conn.send_response(200, "OK", extra_headers={ "Connection": "close" })
          conn.end_response()
          conn.close()
          break
        }
        group.spawn_bg(allow_failure=true, () => {
          defer conn.close()
          let header = request.headers.get("Range").unwrap_or("")
          assert_true(header.has_prefix("bytes="))
          assert_eq(request.headers.get("If-Range"), Some("\"fixture-v1\""))
          assert_eq(request.headers.get("Accept-Encoding"), Some("identity"))
          let bounds = header[6:].split("-").collect()
          assert_eq(bounds.length(), 2)
          let start = @strconv.parse_int(bounds[0])
          let end = @strconv.parse_int(bounds[1]) + 1
          assert_true(start >= 0 && end <= data.length() && end > start)
          let index = start / 4096
          requested.push(index)
          if request.path == "/transient" && index == 0 && transient < 2 {
            transient += 1
            conn.send_response(
              if transient == 1 {
                503
              } else {
                429
              },
              "Temporary",
              extra_headers={ "Retry-After": "0", "Connection": "close" },
            )
            conn.end_response()
            return
          }
          if request.path == "/exhaust" && exhaust {
            conn.send_response(503, "Unavailable", extra_headers={
              "Retry-After": "0",
              "Connection": "close",
            })
            conn.end_response()
            return
          }
          if request.path == "/timeout" && timeout_once {
            timeout_once = false
            @async.sleep(1000)
          }
          let bad = request.path == "/retry" && reject_once
          if bad {
            reject_once = false
          }
          // Gate completion order rather than assuming scheduler/network timing.
          if reverse_first && index < 2 {
            while !completed.contains(index + 1) {
              @async.sleep(1)
            }
          }
          conn.send_response(206, "Partial Content", extra_headers={
            "ETag": if bad {
              "\"changed\""
            } else {
              "\"fixture-v1\""
            },
            "Content-Range": "bytes \{start}-\{end - 1}/\{data.length()}",
            "Connection": "close",
          })
          conn.write(data[start:end].to_owned())
          conn.end_response()
          completed.push(index)
        })
      }
    })
    let path = dir + "/earthquakes.csv"
    let first = invoke(url + "/data", path, [
      "--stop-after-blocks", "3", "--progress",
    ])
    first.check()
    check_progress(first.stdout(), 0L, 3, "paused")
    reverse_first = false
    assert_true(first.stdout().contains("paused: confirmed=12288 fetched=3"))
    assert_eq(requested.length(), 3)
    assert_eq(completed[0], 2)
    let before = @fs.read_file(path + ".mfl").text()
    match @json.parse(before) {
      [_, _, _, _, _, _, Array(records)] => assert_eq(records.length(), 3)
      _ => fail("invalid CLI checkpoint")
    }
    let corrupt = @fs.open(path, mode=ReadWrite)
    corrupt.write_at(b"\x00", position=3L)
    corrupt.sync()
    corrupt.close()
    let damaged_bytes = @fs.read_file(path).binary()
    let damaged_checkpoint = @fs.read_file(path + ".mfl").binary()
    let lock_bytes = @fs.read_file(path + ".mfl.lock").binary()
    let requests_before_audit = requested.length()
    let audit = invoke(url + "/data", path, ["--audit"])
    audit.check()
    let audit_json = @json.parse(audit.stdout().trim())
    assert_eq(
      audit_json.stringify(),
      "[\"MFLAUDIT1\",false,true,\"12288\",\"8192\",[[\"0\",\"4096\"],[\"12288\",\"28008\"]],[[\"0\",\"4096\"]]]",
    )
    assert_eq(@json.parse(audit_json.stringify()), audit_json)
    let repeated_audit = invoke(url + "/data", path, ["--audit"])
    repeated_audit.check()
    assert_eq(repeated_audit.stdout(), audit.stdout())
    let rejected_audit_option = invoke(url + "/data", path, [
      "--audit", "--parallel", "1",
    ])
    assert_true(rejected_audit_option.exit_code() != 0)
    assert_eq(requested.length(), requests_before_audit)
    assert_eq(@fs.read_file(path).binary(), damaged_bytes)
    assert_eq(@fs.read_file(path + ".mfl").binary(), damaged_checkpoint)
    assert_eq(@fs.read_file(path + ".mfl.lock").binary(), lock_bytes)
    assert_true(!@fs.exists(path + ".mfl.next"))
    requested.clear()
    completed.clear()
    let second = invoke(url + "/data", path, ["--progress"])
    second.check()
    check_progress(second.stdout(), 8192L, 5, "complete")
    assert_true(
      second
      .stdout()
      .contains(
        "complete: confirmed=28008 fetched=5 retained=8192 invalidated=1",
      ),
    )
    assert_eq(requested.length(), 5)
    assert_true(
      requested.contains(0) && !requested.contains(1) && !requested.contains(2),
    )
    assert_eq(@fs.read_file(path).binary(), data)
    let checkpoint = @fs.read_file(path + ".mfl").text()
    requested.clear()
    let complete_audit = invoke(url + "/data", path, ["--audit"])
    complete_audit.check()
    assert_eq(
      @json.parse(complete_audit.stdout().trim()).stringify(),
      "[\"MFLAUDIT1\",true,true,\"28008\",\"28008\",[],[]]",
    )
    assert_eq(@fs.read_file(path + ".mfl").text(), checkpoint)
    let third = invoke(url + "/data", path, ["--progress"])
    third.check()
    check_progress(third.stdout(), 28008L, 0, "complete")
    assert_eq(requested.length(), 0)
    assert_eq(@fs.read_file(path + ".mfl").text(), checkpoint)
    let retry_path = dir + "/retry.csv"
    requested.clear()
    let refused = invoke(url + "/retry", retry_path, [
      "--parallel", "1", "--max-attempts", "3",
    ])
    assert_true(refused.exit_code() != 0)
    assert_true(
      (refused.stdout() + refused.stderr()).contains(
        "ETag, range, length or encoding",
      ),
    )
    assert_eq(@fs.file_size(retry_path), 0L)
    assert_eq(requested.length(), 1)
    let retry = invoke(url + "/retry", retry_path, ["--parallel", "1"])
    retry.check()
    assert_eq(@fs.read_file(retry_path).binary(), data)
    requested.clear()
    let transient_path = dir + "/transient.csv"
    let recovered = invoke(url + "/transient", transient_path, [
      "--parallel", "1", "--max-attempts", "3", "--retry-delay-ms", "0",
    ])
    recovered.check()
    assert_eq(requested.length(), 9)
    assert_true(recovered.stdout().contains("fetched=7"))
    assert_eq(@fs.read_file(transient_path).binary(), data)
    requested.clear()
    let exhausted_path = dir + "/exhausted.csv"
    let exhausted = invoke(url + "/exhaust", exhausted_path, [
      "--parallel", "1", "--max-attempts", "3", "--retry-delay-ms", "0",
    ])
    assert_true(exhausted.exit_code() != 0)
    assert_true(
      (exhausted.stdout() + exhausted.stderr()).contains("RetryExhausted"),
    )
    assert_eq(requested.length(), 3)
    assert_eq(@fs.file_size(exhausted_path), 0L)
    match @json.parse(@fs.read_file(exhausted_path + ".mfl").text()) {
      [_, _, _, _, _, _, Array(records)] => assert_eq(records.length(), 0)
      _ => fail("invalid exhausted checkpoint")
    }
    exhaust = false
    let restarted = invoke(url + "/exhaust", exhausted_path, [])
    restarted.check()
    assert_eq(@fs.read_file(exhausted_path).binary(), data)
    requested.clear()
    let timeout_path = dir + "/timeout.csv"
    let timed = invoke(url + "/timeout", timeout_path, [
      "--parallel", "1", "--max-attempts", "2", "--retry-delay-ms", "0", "--request-timeout-ms",
      "250",
    ])
    timed.check()
    assert_eq(requested.length(), 8)
    assert_eq(@fs.read_file(timeout_path).binary(), data)
    let (stopped, _) = @http.get(url + "/__stop")
    assert_eq(stopped.code, 200)
    serving.wait()
    println(first.stdout().trim())
    println(second.stdout().trim())
    println(
      "offline HTTP/disk recovery verified: saved monotonic JSON progress, read-only deterministic audit, reverse arrivals, selective refill, stable checkpoint, fatal version refusal, 503/429 retries, bounded exhaustion/restart and timeout recovery",
    )
  })
}

///|
fn check_progress(
  text : String,
  retained : Int64,
  blocks : Int32,
  final_phase : String,
) -> Unit raise {
  let mut seen = 0
  let mut confirmed = retained
  let mut copied = 0
  for line in text.split("\n") {
    if !line.has_prefix("[\"MFLPROGRESS1\"") {
      continue
    }
    let event = @json.parse(line)
    assert_eq(@json.parse(event.stringify()), event)
    match event {
      [
        "MFLPROGRESS1",
        String(phase),
        "28008",
        String(bytes),
        String(count),
        range,
      ] => {
        if seen == 0 {
          assert_eq(phase, "recovered")
          assert_eq(range, Json::null())
        } else if seen <= blocks {
          assert_eq(phase, "block")
          match range {
            [String(start), String(end)] => {
              let start = @strconv.parse_int64(start)
              let end = @strconv.parse_int64(end)
              assert_true(start % 4096L == 0L && end > start && end <= 28008L)
              confirmed += end - start
              copied += 1
            }
            _ => fail("invalid progress block range")
          }
        } else {
          assert_eq(phase, final_phase)
          assert_eq(range, Json::null())
        }
        assert_eq(@strconv.parse_int64(bytes), confirmed)
        assert_eq(@strconv.parse_int(count), copied)
      }
      _ => fail("invalid progress event schema")
    }
    seen += 1
  }
  assert_eq(seen, blocks + 2)
}
